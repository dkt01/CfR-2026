      <joint name="front_right_steering_joint" type="revolute"><parent>chassis</parent><child>front_right_steering</child><axis><xyz>0 0 1</xyz><limit><lower>-0.40</lower><upper>0.40</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="front_left_wheel_joint" type="revolute"><parent>front_left_steering</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="front_right_wheel_joint" type="revolute"><parent>front_right_steering</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="rear_left_wheel_joint" type="revolute"><parent>chassis</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="rear_right_wheel_joint" type="revolute"><parent>chassis</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
        <topic>/sim/cmd_vel</topic><odom_topic>/model/slash/odometry</odom_topic>
        <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
        <left_steering_joint>front_left_steering_joint</left_steering_joint><right_steering_joint>front_right_steering_joint</right_steering_joint>
        <wheel_base>0.324</wheel_base><wheel_separation>0.296</wheel_separation><wheel_radius>0.055</wheel_radius><steering_limit>0.40</steering_limit>
      </plugin>
    </model>

    <!-- start signal: generated by generate_speed_course.py -->
    <!-- Start signal.  The arms turn on a revolute joint, commanded
         over /start_signal/arm; see scripts/start_signal.py. -->
    <model name="start_signal_frame"><static>true</static><pose>16.0000 3.4000 0 0 0 1.88748</pose>
      <link name="link">
        <visual name="frame_visual"><pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose><geometry><mesh><uri>model://cfr_arduino_bridge/meshes/start_signal_frame.stl</uri></mesh></geometry><material><diffuse>0.53 0.81 0.92 1</diffuse></material></visual>
        <collision name="post_collision"><pose>0 0 0.61 0 0 0</pose><geometry><box><size>0.813 0.10 1.219</size></box></geometry></collision>
      </link>
    </model>
    <model name="start_signal_arms">
      <pose>16.0000 3.4000 0.8130 0 0 1.88748</pose>
      <link name="pivot">
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      </link>
      <link name="arms">
        <gravity>false</gravity>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia></inertial>
          <visual name="red_visual"><pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose><geometry><mesh><uri>model://cfr_arduino_bridge/meshes/start_signal_arm_red.stl</uri></mesh></geometry><material><diffuse>0.85 0.09 0.07 1</diffuse></material></visual>
          <visual name="green_visual"><pose>0.0000 0.0000 0.0000 0.0000 1.5708 0.0000</pose><geometry><mesh><uri>model://cfr_arduino_bridge/meshes/start_signal_arm_green.stl</uri></mesh></geometry><material><diffuse>0.10 0.70 0.20 1</diffuse></material></visual>
      </link>
      <joint name="world_joint" type="fixed"><parent>world</parent><child>pivot</child></joint>
      <joint name="arm_joint" type="revolute">
        <parent>pivot</parent><child>arms</child>
        <axis><xyz>0 1 0</xyz>
          <limit><lower>0.00000</lower><upper>1.57080</upper><effort>50</effort><velocity>5</velocity></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>arm_joint</joint_name>
        <topic>/start_signal/arm</topic>
        <p_gain>12</p_gain>
        <i_gain>0.2</i_gain>
        <d_gain>2.0</d_gain>
      </plugin>
    </model>
    <!-- end start signal -->
  </world>
